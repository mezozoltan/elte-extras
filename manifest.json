{
  "manifest_version": 3,
  "name": "Stuki History",
  "version": "1.9.0",
  "description": "Stuki-előzmények, Progenv-oldalsáv és kimeneteltérés-jelzések, átméretezhető Speci-panelek.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://webprogramozas.inf.elte.hu/*",
    "https://progenv.inf.elte.hu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://progalap.elte.hu/stuki",
        "https://progalap.elte.hu/stuki/*"
      ],
      "js": [
        "model.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://progenv.inf.elte.hu/*"
      ],
      "js": [
        "progenv-model.js",
        "progenv.js",
        "output-diff.js",
        "progenv-output-hints.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://progalap.elte.hu/specifikacio",
        "https://progalap.elte.hu/specifikacio/*"
      ],
      "js": [
        "spec-resize.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "stuki-history@local.invalid",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_title": "Stuki History – Webhelyek",
    "default_popup": "popup.html"
  }
}
