{
  "manifest_version": 3,
  "name": "ELTE Extras",
  "version": "1.10.3",
  "description": "Quality of life changes to sites used by ELTE IK students.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://webprogramozas.inf.elte.hu/*",
    "https://progenv.inf.elte.hu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://progalap.elte.hu/stuki",
        "https://progalap.elte.hu/stuki/*"
      ],
      "js": [
        "model.js",
        "content.js",
        "site-favicon.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://progenv.inf.elte.hu/*"
      ],
      "js": [
        "progenv-model.js",
        "progenv.js",
        "output-diff.js",
        "progenv-output-hints.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://progalap.elte.hu/specifikacio",
        "https://progalap.elte.hu/specifikacio/*"
      ],
      "js": [
        "spec-resize.js",
        "site-favicon.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "elte-extras@spyhq.hu",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_title": "ELTE Extras Sites",
    "default_popup": "popup.html",
    "default_icon": "icons/elte-extras.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/struktogram.png",
        "icons/specifikacio.png"
      ],
      "matches": [
        "https://progalap.elte.hu/*"
      ]
    }
  ],
  "icons": {
    "128": "icons/elte-extras.png"
  }
}
