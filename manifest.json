{
  "manifest_version": 3,
  "name": "Stuki History",
  "version": "1.2.0",
  "description": "Mentett Stuki-struktogramok és korábbi verzióik oldalsó History panelen.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://webprogramozas.inf.elte.hu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://progalap.elte.hu/stuki",
        "https://progalap.elte.hu/stuki/*"
      ],
      "js": [
        "model.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "stuki-history@local.invalid",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
